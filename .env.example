# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# OpenAI — used for gpt-4o (target / judge / attack / translate roles).
OPENAI_API_KEY=

# DeepSeek — used for deepseek-reasoner (target) and deepseek-chat (attack/translate).
DEEPSEEK_API_KEY=

# Anthropic — Claude target/judge via the OpenAI-compatible endpoint.
ANTHROPIC_API_KEY=

# OpenRouter — used to reach Qwen (qwen/qwen-max) and other routed models.
OPENROUTER_API_KEY=
